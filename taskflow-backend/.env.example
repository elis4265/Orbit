# Database
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/taskflow_dev

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (for AI subtask generation)
OPENAI_API_KEY=sk-your-key-here

# Email — pick one:
# Option A: Gmail SMTP (free, works immediately)
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com/apppasswords → generate App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
# Option B: Brevo free tier (300 emails/day) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=taskflow-attachments
MINIO_USE_SSL=false

# App URLs
ENVIRONMENT=development
DEBUG=true
# Comma-separated origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Hocuspocus (collaborative editing) — generate with: python -c "import secrets; print(secrets.token_hex(16))"
HOCUSPOCUS_INTERNAL_KEY=change-this

# OpenTelemetry (optional — omit to disable tracing)
# OTLP_ENDPOINT=http://localhost:4317

# Instance admin (REQ-155, optional) - this email is promoted to superuser at startup
# ORBIT_SUPERUSER_EMAIL=you@example.com
